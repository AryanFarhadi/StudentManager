@model IEnumerable<AKP.Models.Major>

@{
    ViewData["Title"] = "مدیریت رشته‌های تحصیلی";
}

<!-- Page Header Bar -->
<div class="page-header-pro">
    <div class="page-header-title-box">
        <ul class="breadcrumb-pro">
            <li><a asp-controller="Students" asp-action="Index">سامانه</a></li>
            <li class="divider"><i class="bi bi-chevron-left"></i></li>
            <li class="text-dark fw-bold">مدیریت رشته‌های تحصیلی</li>
        </ul>
        <h1>دپارتمان‌ها و رشته‌های تحصیلی دانشگاه</h1>
        <p>تعریف گرایش‌های مجاز، مدیریت چارت تحصیلی و آمار دانشجویان هر دپارتمان</p>
    </div>
    <div>
        <a asp-controller="Students" asp-action="Create" class="btn-brand btn-brand-primary">
            <i class="bi bi-person-plus-fill"></i>
            <span>ثبت‌نام دانشجو در این رشته‌ها</span>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- 1. Quick Add Major Card (Col 4) -->
    <div class="col-12 col-lg-4">
        <div class="panel-pro">
            <div class="panel-pro-header">
                <h2 class="panel-pro-title">
                    <i class="bi bi-plus-circle text-primary"></i>
                    <span>تعریف رشته تحصیلی جدید</span>
                </h2>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="majorTitle" class="form-label-elegant">عنوان رشته تحصیلی *</label>
                        <div class="input-container-elegant">
                            <div class="field-icon"><i class="bi bi-mortarboard"></i></div>
                            <input type="text" 
                                   id="majorTitle" 
                                   name="Title" 
                                   class="form-control" 
                                   placeholder="مثال: مهندسی صنایع" 
                                   required 
                                   autocomplete="off" />
                        </div>
                        <div class="text-muted small mt-1">نام رسمی دپارتمان یا رشته آموزشی</div>
                    </div>

                    <div class="mb-4">
                        <label for="majorCode" class="form-label-elegant">کد رشته (اختیاری)</label>
                        <div class="input-container-elegant">
                            <div class="field-icon"><i class="bi bi-tag"></i></div>
                            <input type="text" 
                                   id="majorCode" 
                                   name="Code" 
                                   class="form-control font-tabular" 
                                   placeholder="مثال: IND-105" 
                                   autocomplete="off" />
                        </div>
                        <div class="text-muted small mt-1">شناسه اختصاری در چارت آموزشی دانشگاه</div>
                    </div>

                    <button type="submit" class="btn-brand btn-brand-primary w-100 shadow-sm">
                        <i class="bi bi-plus-lg"></i>
                        <span>ثبت رشته در سیستم</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. Majors List Table (Col 8) -->
    <div class="col-12 col-lg-8">
        <div class="panel-pro">
            <div class="panel-pro-header">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="panel-pro-title">
                        <i class="bi bi-collection-fill text-primary"></i>
                        <span>فهرست رشته‌های فعال</span>
                    </h2>
                    <span class="badge bg-light text-secondary border font-tabular px-2 py-1">
                        @Model.Count() رشته
                    </span>
                </div>
            </div>

            <div class="p-0">
                @if (Model.Any())
                {
                    <div class="table-pro-responsive">
                        <table class="table-pro">
                            <thead>
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>عنوان دپارتمان / رشته</th>
                                    <th>کد رشته</th>
                                    <th class="text-center">دانشجویان ثبت‌نام شده</th>
                                    <th class="text-center" style="width: 110px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int num = 1; }
                                @foreach (var major in Model)
                                {
                                    var count = major.Students?.Count ?? 0;
                                    <tr>
                                        <td class="text-center text-muted font-tabular">@num</td>
                                        <td class="fw-bold text-dark">
                                            <i class="bi bi-mortarboard text-primary me-2"></i>
                                            @major.Title
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(major.Code))
                                            {
                                                <span class="badge-code">
                                                    @major.Code
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (count > 0)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-tabular px-2 py-1">
                                                    <i class="bi bi-person-fill"></i> @count دانشجو
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border font-tabular px-2 py-1">
                                                    بدون دانشجو
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (count == 0)
                                            {
                                                <a asp-action="Delete" asp-route-id="@major.Id" class="btn-icon-action btn-icon-action-delete" title="حذف رشته">
                                                    <i class="bi bi-trash"></i>
                                                    <span>حذف</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1 small" title="رشته دارای دانشجو است و قابل حذف نیست">
                                                    <i class="bi bi-lock-fill"></i> قفل
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                    num++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-mortarboard display-3 text-muted opacity-25"></i>
                        <h5 class="mt-3 text-dark fw-bold">هنوز هیچ رشته‌ای ثبت نشده است</h5>
                        <p class="text-muted small">از فرم سمت راست برای تعریف اولین رشته استفاده کنید.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
