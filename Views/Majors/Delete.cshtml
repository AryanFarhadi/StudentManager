@model AKP.Models.Major

@{
    ViewData["Title"] = "حذف رشته تحصیلی";
}

<!-- Page Header Bar -->
<div class="page-header-pro">
    <div class="page-header-title-box">
        <ul class="breadcrumb-pro">
            <li><a asp-controller="Students" asp-action="Index">سامانه</a></li>
            <li class="divider"><i class="bi bi-chevron-left"></i></li>
            <li><a asp-action="Index">رشته‌های تحصیلی</a></li>
            <li class="divider"><i class="bi bi-chevron-left"></i></li>
            <li class="text-danger fw-bold">حذف رشته</li>
        </ul>
        <h1 class="text-danger">حذف رشته تحصیلی</h1>
        <p>تأیید نهایی برای حذف دپارتمان آموزشی از دانشگاه</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-brand btn-brand-neutral">
            <i class="bi bi-arrow-right"></i>
            <span>بازگشت به فهرست</span>
        </a>
    </div>
</div>

<div class="form-bounded-card">
    <div class="panel-pro border-danger">
        <div class="panel-pro-header bg-danger-subtle text-danger">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <h2 class="h6 fw-bold mb-0">آیا از حذف رشته «@Model.Title» اطمینان دارید؟</h2>
            </div>
            <span class="badge bg-danger text-white">اقدام دائمی</span>
        </div>

        <div class="p-4 p-md-5">
            <div class="table-responsive border rounded overflow-hidden mb-4">
                <table class="table table-bordered mb-0" style="font-size: 0.875rem;">
                    <tbody>
                        <tr>
                            <th class="bg-light text-secondary" style="width: 35%;">عنوان رشته تحصیلی:</th>
                            <td class="fw-bold">@Model.Title</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-secondary">کد رشته:</th>
                            <td class="font-tabular">@(Model.Code ?? "-")</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-secondary">دانشجویان مرتبط:</th>
                            <td class="font-tabular">
                                @(Model.Students?.Count ?? 0) دانشجو
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn-brand btn-brand-neutral">
                        <i class="bi bi-x-lg"></i>
                        <span>انصراف</span>
                    </a>
                    <button type="submit" class="btn-brand btn-brand-danger px-4 shadow-sm">
                        <i class="bi bi-trash-fill"></i>
                        <span>بله، رشته حذف شود</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
